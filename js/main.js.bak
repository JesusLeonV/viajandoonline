      ],
      'parque-isluga': [
        { name: 'Carmen Silva', stars: 5, text: 'El Volcán Isluga es majestuoso. La experiencia con la cultura aymara fue muy emotiva.', date: '14/06/2026' }
      ],
      'termas-mamina': [
