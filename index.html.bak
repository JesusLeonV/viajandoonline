      <div class="section-title">
        <h2>Tours <span>Destacados</span></h2>
        <p>Las experiencias más elegidas por nuestros viajeros en Iquique</p>
      </div>
      <div class="destacados-grid">
        <a href="https://wa.me/56961470160?text=Hola%2C%20quiero%20reservar%20el%20Full%20Day%20Salitreras%20%E2%80%93%20Oasis%20de%20Pica" target="_blank" rel="noopener" class="destacado-card" style="background-image: url('img/tours/salitreras.jpeg');">
