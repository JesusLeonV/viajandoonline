            <div class="subtitle">La joya secreta del altiplano chileno</div>
            <div class="price"><span class="label">desde</span> $150.000</div>
          </div>
        </a>
        <a href="https://wa.me/56961470160?text=Hola%2C%20quiero%20reservar%20Parapente%20en%20Iquique" target="_blank" rel="noopener" class="destacado-card" style="background-image: url('img/tours/parapente.jpeg');">
