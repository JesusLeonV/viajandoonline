  <!-- POR QUÉ NOSOTROS -->
  <section class="features-section" id="porque" role="region" aria-label="Por qué reservar con nosotros">
    <div class="container">
      <div class="section-title">
        <h2>¿Por qué <span>reservar</span> con nosotros?</h2>
        <p>Garantizamos la mejor experiencia en el Norte de Chile</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">🏆</div>
          <h3>Operadores Profesionales</h3>
          <p>Seleccionamos los mejores guías y operadores locales certificados para asegurar una experiencia segura y auténtica.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">💯</div>
          <h3>Mejor Precio Garantizado</h3>
          <p>Te aseguramos el mejor precio del mercado. Reserva gratis y políticas flexibles de reprogramación y anulación.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">💬</div>
          <h3>Atención Personalizada</h3>
          <p>Expertos disponibles 24/7 vía WhatsApp para ayudarte en la reserva, resolver dudas y planificar tu viaje.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">📸</div>
          <h3>Fotos y Video Incluidos</h3>
          <p>Todos nuestros tours de aventura incluyen sesión de fotos y videos editados, enviados por link de descarga.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">🚐</div>
          <h3>Traslado Incluido</h3>
          <p>Recogemos y dejamos en tu alojamiento de Iquique. Viaja cómodamente en vehículos con aire acondicionado.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" aria-hidden="true">🌿</div>
          <h3>Turismo Sustentable</h3>
          <p>Fomentamos el respeto por las comunidades indígenas y el cuidado del patrimonio cultural y natural de la región.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS + OPINIONES -->
  <section class="testimonials-section" id="testimonios" role="region" aria-label="Testimonios de viajeros">
    <div class="container">
      <div class="section-title">
        <h2>Lo que dicen <span>nuestros viajeros</span></h2>
        <p>Opiniones reales de quienes ya vivieron la experiencia</p>
      </div>

      <!-- FORMULARIO DE OPINIONES -->
      <div class="review-form-section" id="dejar-opinion">
        <div class="review-form-wrapper">
          <h3>Deja tu opinión</h3>
          <p class="review-form-subtitle">¿Visitaste Iquique con nosotros? Cuéntanos tu experiencia</p>
          <form class="review-main-form" id="main-review-form">
            <div class="review-field">
              <label for="main-review-name">Tu nombre</label>
              <input type="text" id="main-review-name" placeholder="Ej: María González" maxlength="40" required>
            </div>
            <div class="review-field">
              <label for="main-review-tour">Tour que visitaste</label>
              <select id="main-review-tour" required>
                <option value="">Selecciona el tour</option>
                <option value="city-tour">City Tour Iquique</option>
                <option value="salitreras-oasis">Salitreras & Oasis de Pica</option>
                <option value="parque-isluga">Parque Nacional Volcán Isluga</option>
                <option value="laguna-roja">Laguna Roja</option>
                <option value="salar-huasco">Salar del Huasco</option>
                <option value="huatacondo">Huatacondo</option>
                <option value="termas-mamina">Tour Mamiña</option>
                <option value="salitreras">Salitreras Humberstone</option>
                <option value="pisagua">Tour Pisagua</option>
                <option value="geoglifos">Geoglifos de Pintados</option>
                <option value="termas-chusmiza">Termas Chusmiza</option>
                <option value="sandboard">Sandboard</option>
                <option value="parapente">Parapente</option>
                <option value="buceo">Buceo</option>
              </select>
            </div>
            <div class="review-field">
              <label>Tu puntuación</label>
              <div class="review-stars-input" id="main-review-stars">
                <span class="star-btn" data-star="1">☆</span>
                <span class="star-btn" data-star="2">☆</span>
                <span class="star-btn" data-star="3">☆</span>
                <span class="star-btn" data-star="4">☆</span>
                <span class="star-btn" data-star="5">☆</span>
              </div>
            </div>
            <div class="review-field">
              <label for="main-review-text">Tu opinión</label>
              <textarea id="main-review-text" placeholder="Cuéntanos cómo fue tu experiencia, qué te gustó más, si lo recomendarías..." maxlength="500" rows="4" required></textarea>
            </div>
            <button type="submit" class="review-submit-btn">Enviar mi opinión</button>
          </form>
          <div id="main-review-success" style="display:none;" class="review-success-msg">
            ¡Gracias por tu opinión! Tu reseña ayudará a otros viajeros.
          </div>
        </div>
      </div>

      <!-- OPINIONES EN GRID -->
      <div class="testimonials-grid" id="user-reviews-list"></div>

    </div>
  </section>

